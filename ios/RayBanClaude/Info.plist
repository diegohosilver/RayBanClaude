<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>RayBan Claude</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>RayBan Claude needs the camera so Claude can see what you show it, and to detect QR codes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RayBan Claude needs the microphone so you can talk to Claude by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>RayBan Claude converts your speech to text on the iPhone.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>For “Remind me tomorrow at 9 to …”, RayBan Claude creates entries in your Reminders app.</string>
	<key>NSRemindersUsageDescription</key>
	<string>For “Remind me tomorrow at 9 to …”, RayBan Claude creates entries in your Reminders app.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>For “Take a photo”, RayBan Claude saves the glasses' photo to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>For “Where am I?” and “Remember where I parked”, RayBan Claude requests your location once – only on demand.</string>
	<key>NSContactsUsageDescription</key>
	<string>For “Call Mom” to work, RayBan Claude looks up the name in your contacts – on the iPhone only; numbers are never sent to Claude.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RayBan Claude connects to your PC on the local Wi-Fi and to your Ray-Ban Meta.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>RayBan Claude uses Bluetooth to connect to the Ray-Ban Meta (camera, microphone, speaker).</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raybanclaude</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>raybanclaude://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(META_CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
