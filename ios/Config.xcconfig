// Shared build settings for RayBan Claude.
// Do NOT enter your own values (team ID, Meta app ID) here; put them in
// ios/Secrets.xcconfig (not committed). Template: Secrets.xcconfig.example

// Bundle ID without hyphens (required by the Meta DAT SDK)
RAYBANCLAUDE_BUNDLE_ID = com.raybanclaude.app

// Apple team – leave empty; Xcode or Sideloadly set it when signing
DEVELOPMENT_TEAM =

// Meta Wearables: not needed in developer mode of the Meta AI app ("0" = no app ID)
META_APP_ID = 0
META_CLIENT_TOKEN =

#include? "Secrets.xcconfig"
