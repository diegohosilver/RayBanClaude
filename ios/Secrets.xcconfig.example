// Copy to ios/Secrets.xcconfig and enter your own values (file is in .gitignore).
// Only needed if you sign in Xcode yourself or distribute the app via Meta release channels.

// Your Apple team ID (Xcode → Settings → Accounts)
DEVELOPMENT_TEAM =

// Your own bundle ID (no hyphens), in case com.raybanclaude.app is already taken
// RAYBANCLAUDE_BUNDLE_ID = com.yourname.raybanclaude

// Only for distribution via Meta release channels (developers.meta.com → Wearables)
META_APP_ID = 0
META_CLIENT_TOKEN =
