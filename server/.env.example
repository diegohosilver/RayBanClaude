# ─────────────────────────────────────────────────────────────────────
# RayBan Claude Gateway – Configuration
# Copy this file to server/.env and fill in your values.
# The .env is NEVER committed (it is listed in .gitignore).
# ─────────────────────────────────────────────────────────────────────

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Port the server listens on in the local network
PORT=18790

# Gateway token for the iOS app (Header "Authorization: Bearer <token>").
# Leave empty = on first start a random token is generated automatically,
# saved to ~/.raybanclaude/gateway-token and shown in the console.
# Custom token: 16-256 characters from A-Z, a-z, 0-9 and ._~+/=-
GATEWAY_API_KEY=

# Optional: Claude model (default: claude-opus-5-5, the current Opus).
# For lower voice latency, use the faster Sonnet model:
# CLAUDE_MODEL=claude-sonnet-5-5
# Most capable model (significantly more expensive, longer response times):
# CLAUDE_MODEL=claude-fable-5-1

# Optional: thinking depth (low, medium, high, xhigh, max; default: medium).
# "low" noticeably shortens the response time. "off" sends no effort value
# (needed for older models without effort support, e.g. claude-haiku-4-5).
# CLAUDE_EFFORT=low

# Optional: custom MCP configuration file ({ "mcpServers": { ... } }).
# If set, ONLY this file is read. Without a value, the operating system's
# Claude Desktop configuration is used.
# MCP_CONFIG_PATH=C:\path\to\mcp-config.json

# Security: which MCP tools Claude may use in the gateway.
# The gateway does NOT ask for confirmation before tool calls - text in a
# camera image could otherwise trick Claude into, e.g., sending an email.
#   empty               → only tools the server marks as "read-only" (default)
#   readonly,gmail/*    → read-only tools + all tools of the server "gmail"
#   calendar/list_events,notes/add_note → individual tools (server/tool)
#   *                   → all tools (only if you knowingly accept the risk)
# MCP_TOOL_ALLOWLIST=

# Optional: additional skill folders (separator: ";" on Windows,
# ":" on macOS/Linux; relative paths refer to the server folder)
# SKILL_PATHS=C:\path\to\skills;D:\more\skills
